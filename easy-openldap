#!/usr/bin/env bash
# VCF-friendly OpenLDAP + phpLDAPadmin installer for a fresh Debian LXC.
#
# Community-helper style:
#   - Native packages (no Docker)
#   - Only prompts for the LDAP administrator password
#   - Uses lab.sg / dc=lab,dc=sg by default
#   - Installs phpLDAPadmin for user/group administration
#   - Enables memberOf for groupOfNames/member
#   - Verifies proper LDAP base-scope behavior
#
# Run:
#   curl -fsSL https://raw.githubusercontent.com/jereloh/pmox_scripts/main/easy-openldap.sh | bash
#
# Optional non-interactive overrides:
#   LDAP_DOMAIN=lab.sg
#   LDAP_ORGANIZATION="Lab SG Directory"
#   LDAP_ADMIN_PASSWORD='your-password'
#
# Supported: Debian 12 / Debian 13

set -Eeuo pipefail
IFS=$'\n\t'

SCRIPT_NAME="install-vcf-openldap.sh"
LOG_FILE="/var/log/vcf-openldap-install.log"
README_FILE="/root/VCF-LDAP-README.txt"

LDAP_DOMAIN="${LDAP_DOMAIN:-lab.sg}"
LDAP_ORGANIZATION="${LDAP_ORGANIZATION:-${LDAP_DOMAIN} Directory}"

exec > >(tee -a "$LOG_FILE") 2>&1
trap 'rc=$?; echo; echo "[ERROR] ${SCRIPT_NAME} failed at line ${LINENO} (exit ${rc})." >&2; echo "See ${LOG_FILE}" >&2; exit ${rc}' ERR

info() { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[FAIL]\033[0m %s\n' "$*" >&2; exit 1; }

need_root() {
  [[ ${EUID} -eq 0 ]] || die "Run this installer as root."
}

check_os() {
  [[ -r /etc/os-release ]] || die "Cannot determine operating system."
  . /etc/os-release

  [[ ${ID:-} == "debian" ]] || die "Debian only. Detected: ${PRETTY_NAME:-unknown}."

  case "${VERSION_ID:-}" in
    12|13) ;;
    *) die "Supported Debian releases are 12 and 13. Detected VERSION_ID=${VERSION_ID:-unknown}." ;;
  esac

  ok "Detected ${PRETTY_NAME}."
}

check_fresh_install() {
  if command -v slapd >/dev/null 2>&1; then
    if ldapsearch -LLL -Y EXTERNAL -H ldapi:/// -b cn=config '(olcSuffix=*)' olcSuffix 2>/dev/null | grep -q '^olcSuffix:'; then
      die "An existing OpenLDAP database was detected. Use a fresh Debian LXC."
    fi
  fi
}

domain_to_base_dn() {
  local domain="$1" part out=""
  IFS='.' read -r -a parts <<< "$domain"
  ((${#parts[@]} >= 2)) || return 1

  for part in "${parts[@]}"; do
    [[ "$part" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || return 1
    [[ -n "$out" ]] && out+=","
    out+="dc=${part}"
  done
  printf '%s' "$out"
}

derive_settings() {
  BASE_DN="$(domain_to_base_dn "$LDAP_DOMAIN")" || die "Invalid LDAP_DOMAIN: ${LDAP_DOMAIN}"
  FIRST_DC="${LDAP_DOMAIN%%.*}"
  LDAP_ADMIN_DN="cn=admin,${BASE_DN}"
  PEOPLE_DN="ou=people,${BASE_DN}"
  GROUPS_DN="ou=groups,${BASE_DN}"
}

prompt_admin_password() {
  if [[ -n "${LDAP_ADMIN_PASSWORD:-}" ]]; then
    [[ ${#LDAP_ADMIN_PASSWORD} -ge 8 ]] || die "LDAP_ADMIN_PASSWORD must be at least 8 characters."
    return
  fi

  [[ -r /dev/tty && -w /dev/tty ]] || die "No interactive TTY available. Set LDAP_ADMIN_PASSWORD in the environment."

  local p1 p2
  echo
  echo "OpenLDAP administrator password"
  echo "Admin DN: ${LDAP_ADMIN_DN}"
  echo

  while true; do
    read -r -s -p "Enter LDAP administrator password: " p1 < /dev/tty
    echo > /dev/tty

    [[ ${#p1} -ge 8 ]] || {
      echo "Password must be at least 8 characters." > /dev/tty
      continue
    }

    read -r -s -p "Confirm LDAP administrator password: " p2 < /dev/tty
    echo > /dev/tty

    [[ "$p1" == "$p2" ]] || {
      echo "Passwords do not match. Try again." > /dev/tty
      continue
    }

    LDAP_ADMIN_PASSWORD="$p1"
    unset p1 p2
    break
  done
}

install_packages() {
  info "Installing OpenLDAP, ldap-utils, Apache, and phpLDAPadmin..."
  export DEBIAN_FRONTEND=noninteractive

  debconf-set-selections <<EOF
slapd slapd/no_configuration boolean false
slapd slapd/domain string ${LDAP_DOMAIN}
slapd shared/organization string ${LDAP_ORGANIZATION}
slapd slapd/password1 password ${LDAP_ADMIN_PASSWORD}
slapd slapd/password2 password ${LDAP_ADMIN_PASSWORD}
slapd slapd/backend select MDB
slapd slapd/purge_database boolean false
slapd slapd/move_old_database boolean true
slapd slapd/allow_ldap_v2 boolean false
EOF

  apt-get update
  apt-get install -y --no-install-recommends \
    slapd ldap-utils apache2 libapache2-mod-php phpldapadmin \
    openssl ssl-cert ca-certificates

  systemctl enable --now slapd apache2
  ok "Packages installed."
}

verify_suffix() {
  local suffix
  suffix="$(ldapsearch -LLL -Y EXTERNAL -H ldapi:/// -b cn=config '(olcSuffix=*)' olcSuffix 2>/dev/null | awk '/^olcSuffix: /{print $2; exit}')"
  [[ "$suffix" == "$BASE_DN" ]] || die "OpenLDAP suffix is '${suffix:-not found}', expected '${BASE_DN}'."
  ok "OpenLDAP suffix: ${BASE_DN}"
}

find_db_dn() {
  DB_DN="$(ldapsearch -LLL -Y EXTERNAL -H ldapi:/// -b cn=config "(olcSuffix=${BASE_DN})" dn 2>/dev/null | awk '/^dn: /{sub(/^dn: /,""); print; exit}')"
  [[ -n "$DB_DN" ]] || die "Could not locate the cn=config database for ${BASE_DN}."
}

load_module_if_needed() {
  local module="$1"

  if ldapsearch -LLL -Y EXTERNAL -H ldapi:/// -b cn=config '(objectClass=olcModuleList)' olcModuleLoad 2>/dev/null | grep -Eq "^olcModuleLoad: .*${module}"; then
    return
  fi

  local module_dn
  module_dn="$(ldapsearch -LLL -Y EXTERNAL -H ldapi:/// -b cn=config '(objectClass=olcModuleList)' dn 2>/dev/null | awk '/^dn: /{sub(/^dn: /,""); print; exit}')"

  if [[ -z "$module_dn" ]]; then
    ldapadd -Y EXTERNAL -H ldapi:/// >/dev/null <<EOF
dn: cn=module{0},cn=config
objectClass: olcModuleList
cn: module{0}
olcModulePath: /usr/lib/ldap
olcModuleLoad: ${module}
EOF
  else
    ldapmodify -Y EXTERNAL -H ldapi:/// >/dev/null <<EOF
dn: ${module_dn}
changetype: modify
add: olcModuleLoad
olcModuleLoad: ${module}
EOF
  fi
}

enable_memberof() {
  info "Enabling memberOf support..."
  load_module_if_needed "memberof"

  if ! ldapsearch -LLL -Y EXTERNAL -H ldapi:/// -b "$DB_DN" '(olcOverlay=memberof*)' dn 2>/dev/null | grep -q '^dn:'; then
    ldapadd -Y EXTERNAL -H ldapi:/// >/dev/null <<EOF
dn: olcOverlay=memberof,${DB_DN}
objectClass: olcOverlayConfig
objectClass: olcMemberOf
olcOverlay: memberof
olcMemberOfDangling: ignore
olcMemberOfRefInt: TRUE
olcMemberOfGroupOC: groupOfNames
olcMemberOfMemberAD: member
olcMemberOfMemberOfAD: memberOf
EOF
  fi

  ok "memberOf overlay enabled."
}

entry_exists() {
  local dn="$1"
  ldapsearch -LLL -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" \
    -b "$dn" -s base '(objectClass=*)' dn 2>/dev/null | grep -q '^dn:'
}

create_basic_tree() {
  info "Creating base LDAP structure..."

  if ! entry_exists "$BASE_DN"; then
    ldapadd -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" >/dev/null <<EOF
dn: ${BASE_DN}
objectClass: top
objectClass: domain
dc: ${FIRST_DC}
description: ${LDAP_ORGANIZATION}
EOF
  fi

  if ! entry_exists "$PEOPLE_DN"; then
    ldapadd -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" >/dev/null <<EOF
dn: ${PEOPLE_DN}
objectClass: top
objectClass: organizationalUnit
ou: people
description: User accounts
EOF
  fi

  if ! entry_exists "$GROUPS_DN"; then
    ldapadd -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" >/dev/null <<EOF
dn: ${GROUPS_DN}
objectClass: top
objectClass: organizationalUnit
ou: groups
description: Groups
EOF
  fi

  ok "Base LDAP structure ready."
}

configure_phpldapadmin() {
  info "Configuring phpLDAPadmin..."

  local cfg="/etc/phpldapadmin/config.php"
  [[ -f "$cfg" ]] || die "phpLDAPadmin config not found at ${cfg}."

  cp -a "$cfg" "${cfg}.pre-vcf-helper" 2>/dev/null || true

  cat > /etc/phpldapadmin/vcf-local.php <<EOF
<?php
\$servers->setValue('server','name','OpenLDAP (${LDAP_DOMAIN})');
\$servers->setValue('server','host','127.0.0.1');
\$servers->setValue('server','port',389);
\$servers->setValue('server','base',array('${BASE_DN}'));
\$servers->setValue('login','auth_type','session');
\$servers->setValue('login','bind_id','${LDAP_ADMIN_DN}');
\$servers->setValue('login','attr','dn');
EOF

  chmod 0640 /etc/phpldapadmin/vcf-local.php
  chown root:www-data /etc/phpldapadmin/vcf-local.php

  if ! grep -q "vcf-local.php" "$cfg"; then
    if grep -q '^?>' "$cfg"; then
      sed -i "/^?>/i require_once '/etc/phpldapadmin/vcf-local.php';" "$cfg"
    else
      printf "\nrequire_once '/etc/phpldapadmin/vcf-local.php';\n" >> "$cfg"
    fi
  fi

  if [[ -e /etc/apache2/conf-available/phpldapadmin.conf ]]; then
    a2enconf phpldapadmin >/dev/null 2>&1 || true
  elif [[ -e /etc/phpldapadmin/apache.conf ]]; then
    ln -sf /etc/phpldapadmin/apache.conf /etc/apache2/conf-available/phpldapadmin.conf
    a2enconf phpldapadmin >/dev/null 2>&1 || true
  fi

  a2enmod ssl rewrite >/dev/null
  a2ensite default-ssl >/dev/null

  cat > /etc/apache2/conf-available/vcf-ldap-force-https.conf <<'EOF'
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^/phpldapadmin(.*)$ https://%{HTTP_HOST}/phpldapadmin$1 [R=302,L]
EOF

  a2enconf vcf-ldap-force-https >/dev/null
  apache2ctl configtest >/dev/null
  systemctl restart apache2

  ok "phpLDAPadmin configured."
}

validate_base_scope() {
  info "Testing LDAP base-scope behavior..."

  local count
  count="$(ldapsearch -LLL -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" \
    -b "$BASE_DN" -s base '(objectClass=*)' dn 2>/dev/null | grep -c '^dn:' || true)"

  [[ "$count" == "1" ]] || die "Base-scope test returned ${count} entries; expected exactly 1."
  ok "Base-scope test passed."
}

validate_memberof() {
  info "Testing inetOrgPerson + groupOfNames + memberOf..."

  local user_dn="uid=vcf-install-test,${PEOPLE_DN}"
  local group_dn="cn=vcf-install-test,${GROUPS_DN}"
  local hash memberof uuid

  hash="$(slappasswd -s "$(openssl rand -hex 18)")"

  ldapdelete -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" "$group_dn" >/dev/null 2>&1 || true
  ldapdelete -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" "$user_dn" >/dev/null 2>&1 || true

  ldapadd -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" >/dev/null <<EOF
dn: ${user_dn}
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: vcf-install-test
cn: VCF Install Test
sn: Test
mail: vcf-install-test@${LDAP_DOMAIN}
userPassword: ${hash}

dn: ${group_dn}
objectClass: top
objectClass: groupOfNames
cn: vcf-install-test
member: ${user_dn}
EOF

  memberof="$(ldapsearch -LLL -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" \
    -b "$user_dn" -s base '(objectClass=*)' memberOf 2>/dev/null | awk '/^memberOf: /{sub(/^memberOf: /,""); print; exit}')"

  uuid="$(ldapsearch -LLL -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" \
    -b "$user_dn" -s base '(objectClass=*)' entryUUID 2>/dev/null | awk '/^entryUUID: /{print $2; exit}')"

  [[ "$memberof" == "$group_dn" ]] || die "memberOf validation failed."
  [[ -n "$uuid" ]] || die "entryUUID validation failed."

  ldapdelete -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" "$group_dn" >/dev/null
  ldapdelete -x -H ldap://127.0.0.1 -D "$LDAP_ADMIN_DN" -w "$LDAP_ADMIN_PASSWORD" "$user_dn" >/dev/null

  ok "memberOf and entryUUID tests passed."
}

install_backup_helper() {
  cat > /usr/local/sbin/backup-openldap <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
OUT_DIR="${1:-/var/backups/openldap}"
STAMP="$(date +%Y%m%d-%H%M%S)"
mkdir -p "$OUT_DIR"
chmod 0700 "$OUT_DIR"
slapcat -n 0 | gzip -9 > "$OUT_DIR/cn-config-${STAMP}.ldif.gz"
slapcat -n 1 | gzip -9 > "$OUT_DIR/directory-${STAMP}.ldif.gz"
echo "Backup written to: $OUT_DIR"
EOF
  chmod 0750 /usr/local/sbin/backup-openldap
}

write_readme() {
  local ip
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [[ -n "$ip" ]] || ip="<LXC-IP>"

  cat > "$README_FILE" <<EOF
OpenLDAP quick reference
========================

Web UI
  https://${ip}/phpldapadmin

Login DN
  ${LDAP_ADMIN_DN}

Base DN
  ${BASE_DN}

Users
  ${PEOPLE_DN}

Groups
  ${GROUPS_DN}

Useful VCF mappings
  User filter:          (objectClass=inetOrgPerson)
  Group filter:         (objectClass=groupOfNames)
  Username attribute:   uid
  Group name attribute: cn
  Object UUID:          entryUUID
  Membership:           memberOf
  Group member:         member

Backup
  /usr/local/sbin/backup-openldap

The installer does NOT save your LDAP administrator password.
EOF

  chmod 0600 "$README_FILE"
}

final_message() {
  local ip
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [[ -n "$ip" ]] || ip="<LXC-IP>"

  echo
  echo "================================================================"
  echo " OpenLDAP installation complete"
  echo "================================================================"
  echo
  echo " Open the web administration UI:"
  echo
  echo "   https://${ip}/phpldapadmin"
  echo
  echo " Login DN:"
  echo "   ${LDAP_ADMIN_DN}"
  echo
  echo " Use the administrator password you entered during installation."
  echo
  echo " From phpLDAPadmin you can now create and manage your own users"
  echo " and groups under:"
  echo
  echo "   ${PEOPLE_DN}"
  echo "   ${GROUPS_DN}"
  echo
  echo " Quick reference: ${README_FILE}"
  echo " Install log:     ${LOG_FILE}"
  echo
  echo " The administrator password was NOT written to disk."
  echo "================================================================"
}

main() {
  need_root
  check_os
  check_fresh_install
  derive_settings
  prompt_admin_password
  install_packages
  verify_suffix
  find_db_dn
  enable_memberof
  create_basic_tree
  configure_phpldapadmin
  validate_base_scope
  validate_memberof
  install_backup_helper
  write_readme
  final_message
}

main "$@"
